{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,127}$"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9.\\-:/^]{0,39}$"
    },
    "side": {
      "enum": [
        "buy",
        "sell"
      ]
    },
    "quantity": {
      "type": "string",
      "pattern": "^\\d+(?:\\.\\d+)?$",
      "maxLength": 80
    },
    "price": {
      "type": "string",
      "pattern": "^\\d+(?:\\.\\d+)?$",
      "maxLength": 80
    },
    "as_of": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "account_id",
    "symbol",
    "side",
    "quantity",
    "price",
    "as_of"
  ],
  "additionalProperties": true
}
