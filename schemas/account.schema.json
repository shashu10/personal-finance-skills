{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,127}$"
    },
    "institution": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "type": {
      "enum": [
        "bank",
        "brokerage",
        "retirement",
        "hsa",
        "pension",
        "education",
        "crypto",
        "other"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "as_of": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "status": {
      "enum": [
        "verified",
        "estimated",
        "unverified"
      ]
    },
    "include_in_totals": {
      "type": "boolean"
    },
    "restricted": {
      "type": "boolean"
    },
    "positions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9.\\-:/^]{0,39}$"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+(?:\\.\\d+)?$",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          },
          "market_value": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+(?:\\.\\d+)?$",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          },
          "cost_basis": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+(?:\\.\\d+)?$",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "symbol",
          "quantity",
          "market_value"
        ],
        "additionalProperties": true
      }
    },
    "cash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d+)?$",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "liabilities": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d+)?$",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "reported_total": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?\\d+(?:\\.\\d+)?$",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "institution",
    "type",
    "currency",
    "as_of",
    "source",
    "status",
    "include_in_totals",
    "restricted",
    "positions",
    "cash",
    "liabilities"
  ],
  "additionalProperties": true
}
