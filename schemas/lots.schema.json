{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,127}$"
          },
          "account_id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,127}$"
          },
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9.\\-:/^]{0,39}$"
          },
          "acquired_on": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "quantity": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)?$",
            "maxLength": 80
          },
          "cost_basis": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+(?:\\.\\d+)?$",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "required": [
          "id",
          "account_id",
          "symbol",
          "acquired_on",
          "quantity",
          "cost_basis",
          "currency"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema_version",
    "items"
  ],
  "additionalProperties": true
}
