{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "account": {
      "$ref": "account.schema.json"
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,127}$"
          },
          "account_id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,127}$"
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "type": {
            "enum": [
              "transfer",
              "income",
              "expense",
              "buy",
              "sell",
              "dividend",
              "fee",
              "other"
            ]
          },
          "amount": {
            "type": "string",
            "pattern": "^-?\\d+(?:\\.\\d+)?$",
            "maxLength": 80
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "required": [
          "id",
          "account_id",
          "date",
          "type",
          "amount",
          "currency"
        ],
        "additionalProperties": true
      }
    },
    "lots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,127}$"
          },
          "account_id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,127}$"
          },
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9.\\-:/^]{0,39}$"
          },
          "acquired_on": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "quantity": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)?$",
            "maxLength": 80
          },
          "cost_basis": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+(?:\\.\\d+)?$",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "required": [
          "id",
          "account_id",
          "symbol",
          "acquired_on",
          "quantity",
          "cost_basis",
          "currency"
        ],
        "additionalProperties": true
      }
    },
    "fx_rates": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "rate": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)?$",
            "maxLength": 80
          },
          "as_of": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "required": [
          "rate",
          "as_of",
          "source"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "account"
  ],
  "additionalProperties": false
}
